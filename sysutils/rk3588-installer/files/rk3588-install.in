#

set -eu

PAYLOAD=%%PREFIX%%/share/rk3588-installer
BSDINSTALL_DISTDIR=${BSDINSTALL_DISTDIR:-/usr/freebsd-dist}
BSDINSTALL_CHROOT=${BSDINSTALL_CHROOT:-/mnt}
DISTRIBUTIONS=${DISTRIBUTIONS:-"base.txz kernel.txz"}

die()
{
	echo "${0##*/}: $*" >&2
	exit 1
}

is_uint()
{
	case "$1" in
	''|*[!0-9]*) return 1 ;;
	*) return 0 ;;
	esac
}

partition_uuid()
{
	partition_provider=${1}p${2}
	gpart list "$1" | awk -v provider="${partition_provider}" '
	    $2 == "Name:" { current = $3 }
	    current == provider && $1 == "rawuuid:" { print $2; exit }
	'
}

read_config()
{
	[ -r "${PAYLOAD}/config" ] || die "missing ${PAYLOAD}/config"
	. "${PAYLOAD}/config"

	case "${FIRMWARE_MIB:-}" in
	16|32) ;;
	*) die "FIRMWARE_MIB must be 16 or 32" ;;
	esac
	is_uint "${FIRMWARE_UPDATE_BYTES:-}" &&
	    [ "${FIRMWARE_UPDATE_BYTES}" -gt 0 ] &&
	    [ $((FIRMWARE_UPDATE_BYTES % 512)) -eq 0 ] &&
	    [ "${FIRMWARE_UPDATE_BYTES}" -le $((FIRMWARE_MIB * 1024 * 1024)) ] ||
	    die "FIRMWARE_UPDATE_BYTES must be a sector-aligned firmware prefix"
	is_uint "${ESP_MIB:-}" && [ "${ESP_MIB}" -gt 0 ] ||
	    die "ESP_MIB must be a positive integer"
	case "${ROOT_LABEL:-}" in
	''|*[!A-Za-z0-9_-]*) die "invalid ROOT_LABEL" ;;
	esac
	case "${ZFS_POOL_NAME:-}" in
	''|[!A-Za-z]*|*[!A-Za-z0-9_-]*)
		die "invalid ZFS_POOL_NAME"
		;;
	esac
}

calculate_layout()
{
	reserve_sectors=$((FIRMWARE_MIB * 2048))
	firmware_start=40
	firmware_sectors=$((reserve_sectors - firmware_start))
	esp_start=${reserve_sectors}
	esp_sectors=$((ESP_MIB * 2048))
	swap_start=$((esp_start + esp_sectors))
	swap_sectors=$((SWAP_MIB * 2048))
	root_start=$((swap_start + swap_sectors))
	root_partition=3
	[ "${SWAP_MIB}" -eq 0 ] || root_partition=4
}

mounted_provider()
{
	mount -p | awk -v path="$1" '$2 == path { print $1; exit }'
}

provider_disk_name()
{
	name=$1
	if supported_target "${name}"; then
		echo "${name}"
		return
	fi
	case "${name}" in
	*p*)
		disk=${name%p*}
		partition=${name#"${disk}"p}
		if supported_target "${disk}" && is_uint "${partition}"; then
			echo "${disk}"
			return
		fi
		;;
	esac
	return 1
}

provider_disk()
{
	provider=${1#/dev/}
	provider_disk_name "${provider}" && return

	provider=$(geom label status -s |
	    awk -v name="${provider}" '$1 == name { print $3; exit }')
	[ -n "${provider}" ] || return 1
	provider_disk_name "${provider}"
}

provider_paths_to_disks()
{
	[ "$#" -gt 0 ] || return 1
	disks=
	for path in "$@"; do
		disk=$(provider_disk_name "${path#/dev/}") || return 1
		case " ${disks} " in
		*" ${disk} "*) ;;
		*) disks="${disks}${disks:+ }${disk}" ;;
		esac
	done
	echo "${disks}"
}

source_provider_disks()
{
	if disk=$(provider_disk "$1" 2>/dev/null); then
		echo "${disk}"
		return
	fi
	command -v zpool >/dev/null 2>&1 || return 1
	pool=${1%%/*}
	paths=$(zpool status -LP "${pool}" 2>/dev/null |
	    awk '$1 ~ /^\/dev\// { print $1 }')
	[ -n "${paths}" ] || return 1
	provider_paths_to_disks ${paths}
}

is_source_disk()
{
	case " ${source_disks} " in
	*" $1 "*) return 0 ;;
	*) return 1 ;;
	esac
}

boot_storage()
{
	hex=$(ofwdump -P rockchip,boot-storage /chosen |
	    awk 'NF == 4 && $1 ~ /^[[:xdigit:]][[:xdigit:]]$/ {
		print $4
		exit
	    }')
	[ -n "${hex}" ] || return 1
	echo $((0x${hex}))
}

supported_target()
{
	case "$1" in
	mmcsd*) unit=${1#mmcsd} ;;
	ada*) unit=${1#ada} ;;
	da*) unit=${1#da} ;;
	nda*) unit=${1#nda} ;;
	nvd*) unit=${1#nvd} ;;
	*) return 1 ;;
	esac
	is_uint "${unit}"
}

target_description()
{
	diskinfo -v "/dev/$1" | awk '
	    /# mediasize in bytes/ { size = $6 }
	    /# Disk descr/ {
		sub(/^[[:space:]]*/, "")
		sub(/[[:space:]]+#.*/, "")
		description = $0
	    }
	    END {
		if (size == "")
			size = "unknown size"
		if (description == "")
			description = "storage device"
		printf "%s - %s", size, description
	    }
	'
}

provider_list_uses_disk()
{
	awk -v disk="/dev/$1" '
	    $1 == disk { found = 1 }
	    index($1, disk "p") == 1 {
		partition = substr($1, length(disk) + 2)
		if (partition ~ /^[0-9]+$/)
			found = 1
	    }
	    END { exit !found }
	'
}

choose_target()
{
	source_provider=$(mounted_provider /)
	[ -n "${source_provider}" ] || die "cannot resolve live root provider"
	source_disks=$(source_provider_disks "${source_provider}") ||
	    die "unsupported live root provider: ${source_provider}"

	if [ -n "${1:-}" ]; then
		target_disk=${1#/dev/}
	else
		set --
		for disk in $(sysctl -n kern.disks); do
			supported_target "${disk}" || continue
			is_source_disk "${disk}" && continue
			set -- "$@" "${disk}" "$(target_description "${disk}")"
		done
		[ "$#" -gt 0 ] || die "no supported target disk is available"
		exec 3>&1
		target_disk=$(dialog --backtitle "RK3588 FreeBSD Installer" \
		    --title "Installation target" --menu \
		    "Live root disk(s) ${source_disks} are excluded.\n\
Choose the disk to erase and install:" 0 0 0 "$@" 2>&1 1>&3)
		exec 3>&-
	fi

	supported_target "${target_disk}" ||
	    die "unsupported target disk: ${target_disk}"
	! is_source_disk "${target_disk}" ||
	    die "refusing to overwrite live root disk ${target_disk}"
	[ -c "/dev/${target_disk}" ] ||
	    die "missing /dev/${target_disk}"

	for provider in $(mount -p | awk '{ print $1 }'); do
		disk=$(provider_disk "${provider}" 2>/dev/null || true)
		[ "${disk}" != "${target_disk}" ] ||
		    die "${target_disk} still has mounted filesystems"
	done
	if command -v zpool >/dev/null 2>&1 &&
	    zpool status -LP 2>/dev/null |
	    provider_list_uses_disk "${target_disk}"; then
		die "${target_disk} is used by an imported ZFS pool"
	fi
}

choose_uboot()
{
	case "${target_disk}" in
	mmcsd*) ;;
	*)
		case "${RK3588_INSTALL_UBOOT:-NO}" in
		NO) install_uboot=NO; return ;;
		YES) die "U-Boot can only be written to an MMC target" ;;
		*) die "RK3588_INSTALL_UBOOT must be YES or NO" ;;
		esac
		;;
	esac
	if [ -n "${RK3588_INSTALL_UBOOT:-}" ]; then
		install_uboot=${RK3588_INSTALL_UBOOT}
	else
		exec 3>&1
		install_uboot=$(dialog --backtitle "RK3588 FreeBSD Installer" \
		    --title "Install U-Boot" --menu \
		    "Write the bundled U-Boot firmware to /dev/${target_disk}?\n\n\
Choose NO when boot firmware is provided by SPI or another disk." \
		    0 0 0 \
		    NO "Do not write or replace U-Boot" \
		    YES "Write U-Boot to this MMC disk" 2>&1 1>&3)
		exec 3>&-
	fi
	case "${install_uboot}" in
	YES|NO) ;;
	*) die "RK3588_INSTALL_UBOOT must be YES or NO" ;;
	esac
}

choose_filesystem()
{
	if [ -n "${RK3588_INSTALL_FS:-}" ]; then
		filesystem=${RK3588_INSTALL_FS}
	else
		exec 3>&1
		filesystem=$(dialog --backtitle "RK3588 FreeBSD Installer" \
		    --title "Root filesystem" --menu \
		    "Choose the target root filesystem:" 0 0 0 \
		    ufs "UFS with soft updates" \
		    zfs "ZFS root pool" 2>&1 1>&3)
		exec 3>&-
	fi
	case "${filesystem}" in
	ufs|zfs) ;;
	*) die "filesystem must be ufs or zfs" ;;
	esac
}

choose_swap()
{
	if [ -n "${RK3588_INSTALL_SWAP_MIB:-}" ]; then
		SWAP_MIB=${RK3588_INSTALL_SWAP_MIB}
	else
		exec 3>&1
		SWAP_MIB=$(dialog --backtitle "RK3588 FreeBSD Installer" \
		    --title "Swap size" --inputbox \
		    "Swap partition size in MiB (0 disables swap):" \
		    0 0 "0" 2>&1 1>&3)
		exec 3>&-
	fi
	is_uint "${SWAP_MIB}" || die "swap size must be a non-negative integer"
}

choose_rk3588_services()
{
	if [ -n "${RK3588_INSTALL_RTC:-}" ] ||
	    [ -n "${RK3588_INSTALL_WATCHDOG:-}" ]; then
		enable_rtc=${RK3588_INSTALL_RTC:-NO}
		enable_watchdog=${RK3588_INSTALL_WATCHDOG:-NO}
	else
		exec 3>&1
		rk3588_services=$(dialog --backtitle "RK3588 FreeBSD Installer" \
		    --title "RK3588 Services" --no-cancel --separate-output \
		    --checklist \
		    "Choose optional RK3588 services to start at boot:" 0 0 0 \
		    rtc "HYM8563 real-time clock" off \
		    dwwdt "Hardware watchdog (dwwdt and watchdogd)" off \
		    2>&1 1>&3)
		exec 3>&-
		case " ${rk3588_services} " in
		*" rtc "*) enable_rtc=YES ;;
		*) enable_rtc=NO ;;
		esac
		case " ${rk3588_services} " in
		*" dwwdt "*) enable_watchdog=YES ;;
		*) enable_watchdog=NO ;;
		esac
	fi
	case "${enable_rtc}" in
	YES|NO) ;;
	*) die "RK3588_INSTALL_RTC must be YES or NO" ;;
	esac
	case "${enable_watchdog}" in
	YES|NO) ;;
	*) die "RK3588_INSTALL_WATCHDOG must be YES or NO" ;;
	esac
}

confirm_install()
{
	[ "${RK3588_INSTALL_ASSUME_YES:-NO}" = YES ] && return
	dialog --backtitle "RK3588 FreeBSD Installer" \
	    --title "Destroy ${target_disk}" --defaultno --yesno \
	    "ALL DATA on /dev/${target_disk} will be destroyed.\n\n\
Live root disk(s): ${source_disks}\n\
Target: /dev/${target_disk}\n\
Current boot storage: ${storage_name}\n\
Install U-Boot on target: ${install_uboot}\n\
Filesystem: ${filesystem}\n\
Swap: ${SWAP_MIB} MiB\n\
Firmware area: ${FIRMWARE_MIB} MiB\n\n\
Continue?" 0 0 ||
	    exit 0
}

check_capacity()
{
	disk_info=$(diskinfo "/dev/${target_disk}")
	sector_size=$(echo "${disk_info}" | awk '{ print $2 }')
	[ "${sector_size}" = 512 ] ||
	    die "${target_disk} must expose 512-byte logical sectors"
	media_bytes=$(echo "${disk_info}" | awk '{ print $3 }')
	is_uint "${media_bytes}" || die "cannot read ${target_disk} capacity"
	minimum_bytes=$(((root_start + 2097152) * 512))
	[ "${media_bytes}" -ge "${minimum_bytes}" ] ||
	    die "${target_disk} is too small; at least 1 GiB root space is required"
}

install_firmware()
{
	[ "${install_uboot}" = YES ] || {
		echo "Skipping U-Boot write to /dev/${target_disk}"
		return
	}

	firmware=${PAYLOAD}/firmware-update.bin
	firmware_sectors=$((FIRMWARE_UPDATE_BYTES / 512))
	[ -f "${firmware}" ] || die "missing ${firmware}"
	[ "$(stat -f %z "${firmware}")" -eq "${FIRMWARE_UPDATE_BYTES}" ] ||
	    die "${firmware} has an unexpected size"

	echo "Writing RK3588 firmware prefix to /dev/${target_disk}"
	dd if="${firmware}" of="/dev/${target_disk}" bs=512 \
	    count="${firmware_sectors}" conv=notrunc,fsync status=none
	cmp -s -n "${FIRMWARE_UPDATE_BYTES}" \
	    "${firmware}" "/dev/${target_disk}" ||
	    die "firmware readback verification failed"
	echo "Firmware readback verification passed"
}

partition_target()
{
	if gpart show "${target_disk}" >/dev/null 2>&1; then
		gpart destroy -F "${target_disk}"
	fi
	install_firmware
	gpart create -s gpt "${target_disk}"
	firmware_start=$(gpart show -p "${target_disk}" |
	    awk '$3 == "-" && $4 == "free" { print $1; exit }')
	is_uint "${firmware_start}" ||
	    die "cannot determine first usable GPT sector"
	[ "${firmware_start}" -le 64 ] ||
	    die "GPT metadata overlaps idbloader at LBA 64"
	firmware_sectors=$((reserve_sectors - firmware_start))
	[ "${firmware_sectors}" -gt 0 ] ||
	    die "firmware reservation is too small"
	gpart add -b "${firmware_start}" -s "${firmware_sectors}" \
	    -t freebsd-boot -l rk3588_firmware "${target_disk}"
	gpart add -b "${esp_start}" -s "${esp_sectors}" \
	    -t efi -l EFI "${target_disk}"
	if [ "${SWAP_MIB}" -gt 0 ]; then
		gpart add -b "${swap_start}" -s "${swap_sectors}" \
		    -t freebsd-swap -l freebsd_swap "${target_disk}"
	fi
	gpart add -b "${root_start}" -t "freebsd-${filesystem}" \
	    -l freebsd_root "${target_disk}"
	esp_uuid=$(partition_uuid "${target_disk}" 2)
	root_uuid=$(partition_uuid "${target_disk}" "${root_partition}")
	[ -n "${esp_uuid}" ] || die "cannot determine ESP partition GUID"
	[ -n "${root_uuid}" ] || die "cannot determine root partition GUID"
	swap_uuid=
	if [ "${SWAP_MIB}" -gt 0 ]; then
		swap_uuid=$(partition_uuid "${target_disk}" 3)
		[ -n "${swap_uuid}" ] ||
		    die "cannot determine swap partition GUID"
	fi
	if [ "${install_uboot}" = YES ]; then
		offset=$((64 * 512))
		cmp -s -i "${offset}:${offset}" \
		    -n "$((FIRMWARE_UPDATE_BYTES - offset))" \
		    "${firmware}" "/dev/${target_disk}" ||
		    die "firmware verification after GPT creation failed"
		echo "Firmware verification after GPT creation passed"
	fi
}

prepare_bsdinstall()
{
	install_work=$(mktemp -d /tmp/rk3588-install.XXXXXX)
	export BSDINSTALL_TMPETC="${install_work}/etc"
	export BSDINSTALL_TMPBOOT="${install_work}/boot"
	export PATH_FSTAB="${BSDINSTALL_TMPETC}/fstab"
	export BSDINSTALL_DISTDIR BSDINSTALL_CHROOT DISTRIBUTIONS
	mkdir -p "${BSDINSTALL_TMPETC}" "${BSDINSTALL_TMPBOOT}"
	: > "${PATH_FSTAB}"

	bsdinstall keymap || true
	bsdinstall hostname
}

mount_target()
{
	mkdir -p "${BSDINSTALL_CHROOT}"
	newfs_msdos -F 16 -L EFI "/dev/${target_disk}p2" >/dev/null

	if [ "${filesystem}" = ufs ]; then
		zpool labelclear -f "/dev/${target_disk}p${root_partition}" \
		    >/dev/null 2>&1 || true
		newfs -U -L "${ROOT_LABEL}" \
		    "/dev/${target_disk}p${root_partition}" >/dev/null
		mount "/dev/${target_disk}p${root_partition}" \
		    "${BSDINSTALL_CHROOT}"
		root_mounted=1
		printf '/dev/gptid/%s\t/\tufs\trw,noatime\t1\t1\n' \
		    "${root_uuid}" >> "${PATH_FSTAB}"
	else
		zpool create -f -R "${BSDINSTALL_CHROOT}" \
		    -O atime=off -O compression=lz4 -O mountpoint=none \
		    "${ZFS_POOL_NAME}" \
		    "/dev/${target_disk}p${root_partition}"
		pool_created=1
		zfs create -o mountpoint=none "${ZFS_POOL_NAME}/ROOT"
		zfs create -o mountpoint=/ "${ZFS_POOL_NAME}/ROOT/default"
		zpool set bootfs="${ZFS_POOL_NAME}/ROOT/default" \
		    "${ZFS_POOL_NAME}"
	fi

	mkdir -p "${BSDINSTALL_CHROOT}/boot/efi"
	mount -t msdosfs "/dev/${target_disk}p2" \
	    "${BSDINSTALL_CHROOT}/boot/efi"
	esp_mounted=1
	printf '/dev/gptid/%s\t/boot/efi\tmsdosfs\trw,noatime\t0\t0\n' \
	    "${esp_uuid}" >> "${PATH_FSTAB}"
	if [ "${SWAP_MIB}" -gt 0 ]; then
		printf '/dev/gptid/%s\tnone\tswap\tsw\t0\t0\n' \
		    "${swap_uuid}" >> "${PATH_FSTAB}"
	fi
}

merge_config()
{
	baseline=$1
	target=$2
	name=$3
	overlay=${install_work}/${name}.installed
	merged=${install_work}/${name}.merged

	[ -f "${baseline}" ] || return
	[ -f "${target}" ] || : > "${target}"
	cp -p "${target}" "${overlay}"
	awk '
	function key(line, pos, result) {
		pos = index(line, "=")
		if (pos == 0)
			return ""
		result = substr(line, 1, pos - 1)
		gsub(/^[[:space:]]+|[[:space:]]+$/, "", result)
		if (result !~ /^[A-Za-z0-9_.]+$/)
			return ""
		return result
	}
	FNR == NR {
		result = key($0)
		if (result != "")
			override[result] = 1
		next
	}
	{
		result = key($0)
		if (result == "" || !override[result])
			print
	}
	' "${overlay}" "${baseline}" > "${merged}"
	cat "${overlay}" >> "${merged}"
	cp -p "${merged}" "${target}"
}

set_config()
{
	target=$1
	name=$2
	value=$3
	updated=${install_work}/${name}.updated

	awk -v name="${name}" -v replacement="${name}=\"${value}\"" '
	function key(line, pos, result) {
		pos = index(line, "=")
		if (pos == 0)
			return ""
		result = substr(line, 1, pos - 1)
		gsub(/^[[:space:]]+|[[:space:]]+$/, "", result)
		return result
	}
	key($0) == name {
		if (!found)
			print replacement
		found = 1
		next
	}
	{ print }
	END {
		if (!found)
			print replacement
	}
	' "${target}" > "${updated}"
	cp -p "${updated}" "${target}"
}

configure_target()
{
	[ -f "${PAYLOAD}/rc.conf.base" ] ||
	    die "missing ${PAYLOAD}/rc.conf.base"
	[ -f "${PAYLOAD}/loader.conf.base" ] ||
	    die "missing ${PAYLOAD}/loader.conf.base"
	merge_config "${PAYLOAD}/rc.conf.base" \
	    "${BSDINSTALL_CHROOT}/etc/rc.conf" rc.conf
	merge_config "${PAYLOAD}/loader.conf.base" \
	    "${BSDINSTALL_CHROOT}/boot/loader.conf" loader.conf
	if [ -f "${PAYLOAD}/loader.conf.board" ]; then
		cat "${PAYLOAD}/loader.conf.board" >> \
		    "${BSDINSTALL_CHROOT}/boot/loader.conf"
	fi

	mkdir -p "${BSDINSTALL_CHROOT}/boot/efi/dtb"
	cp -p "${PAYLOAD}/freebsd.dtb" \
	    "${BSDINSTALL_CHROOT}/boot/efi/dtb/freebsd.dtb"
	[ -x /usr/local/sbin/pkg ] ||
	    die "live image is missing the prebuilt pkg package"
	[ -f "${PAYLOAD}/pkg.pkg" ] ||
	    die "missing ${PAYLOAD}/pkg.pkg"
	ASSUME_ALWAYS_YES=yes /usr/local/sbin/pkg -r "${BSDINSTALL_CHROOT}" \
	    -o REPO_AUTOUPDATE=false add "${PAYLOAD}/pkg.pkg"
	[ -x "${BSDINSTALL_CHROOT}/usr/local/sbin/pkg" ] ||
	    die "pkg.pkg did not install pkg"
	[ -f "${PAYLOAD}/if_rge.pkg" ] ||
	    die "missing ${PAYLOAD}/if_rge.pkg"
	tar --exclude '+*' -xpf "${PAYLOAD}/if_rge.pkg" \
	    -C "${BSDINSTALL_CHROOT}"
	[ -f "${BSDINSTALL_CHROOT}/boot/modules/if_rge.ko" ] ||
	    die "if_rge.pkg did not install if_rge.ko"
	if [ -f "${PAYLOAD}/yt921x.pkg" ]; then
		ASSUME_ALWAYS_YES=yes /usr/local/sbin/pkg \
		    -r "${BSDINSTALL_CHROOT}" -o REPO_AUTOUPDATE=false \
		    add "${PAYLOAD}/yt921x.pkg"
		[ -f "${BSDINSTALL_CHROOT}/boot/modules/yt921x.ko" ] ||
		    die "yt921x.pkg did not install yt921x.ko"
	fi
	[ -f "${PAYLOAD}/rtlbt-firmware.pkg" ] ||
	    die "missing ${PAYLOAD}/rtlbt-firmware.pkg"
	ASSUME_ALWAYS_YES=yes /usr/local/sbin/pkg -r "${BSDINSTALL_CHROOT}" \
	    -o REPO_AUTOUPDATE=false add \
	    "${PAYLOAD}/rtlbt-firmware.pkg"
	[ -f "${BSDINSTALL_CHROOT}/usr/local/share/rtlbt-firmware/rtl8822cu_fw.bin" ] ||
	    die "rtlbt-firmware package did not install RTL8822CU firmware"
	[ -f "${PAYLOAD}/uboot-config.pkg" ] ||
	    die "missing ${PAYLOAD}/uboot-config.pkg"
	ASSUME_ALWAYS_YES=yes /usr/local/sbin/pkg -r "${BSDINSTALL_CHROOT}" \
	    -o REPO_AUTOUPDATE=false add "${PAYLOAD}/uboot-config.pkg"
	[ -x "${BSDINSTALL_CHROOT}/usr/local/sbin/rk3588-uboot-config" ] ||
	    die "uboot-config.pkg did not install rk3588-uboot-config"

	loader_conf=${BSDINSTALL_CHROOT}/boot/loader.conf
	set_config "${loader_conf}" boot_multicons YES
	set_config "${loader_conf}" boot_serial YES
	set_config "${loader_conf}" console comconsole,efi
	set_config "${loader_conf}" comconsole_speed 1500000
	set_config "${loader_conf}" hw.rk3588.efi_fdt_highmem 1
	set_config "${loader_conf}" if_rge_load YES
	set_config "${loader_conf}" if_rge_name /boot/modules/if_rge.ko
	if [ "${enable_rtc}" = YES ]; then
		[ -f "${BSDINSTALL_CHROOT}/boot/kernel/hym8563.ko" ] ||
		    die "installed kernel does not provide hym8563.ko"
	fi
	set_config "${loader_conf}" hym8563_load "${enable_rtc}"
	if [ "${enable_watchdog}" = YES ]; then
		[ -f "${BSDINSTALL_CHROOT}/boot/kernel/dwwdt.ko" ] ||
		    die "installed kernel does not provide dwwdt.ko"
	fi
	set_config "${loader_conf}" dwwdt_load "${enable_watchdog}"
	if [ "${enable_rtc}" = YES ]; then
		devmatch_rtc=-=hym8563
	else
		devmatch_rtc=+=hym8563
	fi
	if [ "${enable_watchdog}" = YES ]; then
		devmatch_watchdog=-=dwwdt
	else
		devmatch_watchdog=+=dwwdt
	fi
	sysrc -q -R "${BSDINSTALL_CHROOT}" \
	    "devmatch_blocklist${devmatch_rtc}" \
	    "devmatch_blocklist${devmatch_watchdog}"
	sysrc -q -R "${BSDINSTALL_CHROOT}" \
	    watchdogd_enable="${enable_watchdog}"
	if [ "${filesystem}" = ufs ]; then
		set_config "${loader_conf}" vfs.root.mountfrom \
		    "ufs:/dev/gptid/${root_uuid}"
	else
		mkdir -p "${BSDINSTALL_CHROOT}/boot/zfs"
		zpool set cachefile="${BSDINSTALL_CHROOT}/boot/zfs/zpool.cache" \
		    "${ZFS_POOL_NAME}"
		set_config "${loader_conf}" zfs_load YES
		set_config "${loader_conf}" vfs.root.mountfrom \
		    "zfs:${ZFS_POOL_NAME}/ROOT/default"
		sysrc -q -R "${BSDINSTALL_CHROOT}" zfs_enable=YES
	fi
	sysrc -q -R "${BSDINSTALL_CHROOT}" \
	    ntpd_enable=YES ntpd_sync_on_start=YES powerd_enable=YES
}

configure_freebsd()
{
	bsdinstall checksum
	bsdinstall distextract
	bsdinstall bootconfig
	bsdinstall rootpass
	bsdinstall netconfig || true
	bsdinstall time
	bsdinstall services
	choose_rk3588_services
	bsdinstall hardening

	if dialog --backtitle "RK3588 FreeBSD Installer" \
	    --title "Add User Accounts" --yesno \
	    "Would you like to add a user now?" 0 0; then
		bsdinstall adduser
	fi

	bsdinstall config
	configure_target
	bsdinstall entropy
}

cleanup()
{
	set +e
	sync
	if [ "${esp_mounted:-0}" = 1 ]; then
		umount "${BSDINSTALL_CHROOT}/boot/efi"
	fi
	if [ "${pool_created:-0}" = 1 ]; then
		zpool export "${ZFS_POOL_NAME}"
	elif [ "${root_mounted:-0}" = 1 ]; then
		umount "${BSDINSTALL_CHROOT}"
	fi
	if [ -n "${install_work:-}" ] && [ -d "${install_work}" ]; then
		find "${install_work}" -depth -delete
	fi
}

install_system()
{
	read_config
	storage=$(boot_storage) ||
	    die "this system was not started by a supported RK3588 U-Boot"
	case "${storage}" in
	1) storage_name="eMMC (1)" ;;
	2) storage_name="SD (2)" ;;
	9) storage_name="SPI NOR (9)" ;;
	*) die "unsupported RK3588 U-Boot storage value: ${storage}" ;;
	esac
	echo "Detected current boot storage: ${storage_name}"
	choose_target "${1:-}"
	choose_uboot
	choose_filesystem
	choose_swap
	calculate_layout
	check_capacity
	confirm_install

	esp_mounted=0
	root_mounted=0
	pool_created=0
	install_work=
	trap cleanup EXIT
	trap 'exit 1' HUP INT TERM

	prepare_bsdinstall
	partition_target
	mount_target
	configure_freebsd
	cleanup
	trap - EXIT HUP INT TERM

	echo "FreeBSD installation on /dev/${target_disk} completed."
}

assert_eq()
{
	[ "$1" = "$2" ] || die "selftest: expected $2, got $1"
}

selftest()
{
	install_work=$(mktemp -d -t rk3588-install-selftest)
	cat > "${install_work}/base.conf" <<'EOF'
baseline="kept"
shared="base"
root="old"
EOF
	cat > "${install_work}/overlay.conf" <<'EOF'
shared="installed"
target="kept"
EOF
	merge_config "${install_work}/base.conf" \
	    "${install_work}/overlay.conf" merge-test
	set_config "${install_work}/overlay.conf" root new
	assert_eq "$(grep -c '^shared=' "${install_work}/overlay.conf")" 1
	grep -q '^baseline="kept"$' "${install_work}/overlay.conf" ||
	    die "selftest: baseline setting was not preserved"
	grep -q '^shared="installed"$' "${install_work}/overlay.conf" ||
	    die "selftest: installed setting did not override baseline"
	grep -q '^root="new"$' "${install_work}/overlay.conf" ||
	    die "selftest: set_config did not replace root"
	find "${install_work}" -depth -delete
	install_work=

	FIRMWARE_MIB=16
	ESP_MIB=256
	SWAP_MIB=0
	calculate_layout
	assert_eq "${firmware_sectors}" 32728
	assert_eq "${esp_start}" 32768
	assert_eq "${root_start}" 557056
	assert_eq "${root_partition}" 3

	FIRMWARE_MIB=32
	SWAP_MIB=512
	calculate_layout
	assert_eq "${firmware_sectors}" 65496
	assert_eq "${esp_start}" 65536
	assert_eq "${root_start}" 1638400
	assert_eq "${root_partition}" 4

	for disk in mmcsd0 mmcsd12 ada0 da3 nda0 nvd2; do
		supported_target "${disk}" ||
		    die "selftest: ${disk} must be supported"
	done
	for disk in mmcsd0p1 ada0p2 da nda0p1 nvd-1 nvme0 cd0; do
		if supported_target "${disk}"; then
			die "selftest: ${disk} must not be supported"
		fi
	done
	assert_eq "$(provider_disk_name nda0p3)" nda0
	assert_eq "$(provider_paths_to_disks /dev/nda0p3 /dev/nda1p4 \
	    /dev/nda0p3)" "nda0 nda1"
	if provider_disk_name nda0s1 >/dev/null 2>&1; then
		die "selftest: MBR slices must not be accepted"
	fi
	printf '/dev/nda0p3 ONLINE\n' |
	    provider_list_uses_disk nda0 ||
	    die "selftest: target ZFS provider was not detected"
	if printf '/dev/nda1p3 ONLINE\n' |
	    provider_list_uses_disk nda0; then
		die "selftest: unrelated ZFS provider matched target"
	fi
	source_disks="mmcsd0 nda1"
	is_source_disk nda1 || die "selftest: live root disk was not matched"
	if is_source_disk nda0; then
		die "selftest: unrelated disk matched live root"
	fi
	target_disk=mmcsd0
	RK3588_INSTALL_UBOOT=YES
	choose_uboot
	assert_eq "${install_uboot}" YES
	RK3588_INSTALL_UBOOT=NO
	choose_uboot
	assert_eq "${install_uboot}" NO
	unset RK3588_INSTALL_UBOOT
	target_disk=nda0
	choose_uboot
	assert_eq "${install_uboot}" NO
	if (RK3588_INSTALL_UBOOT=YES; choose_uboot) >/dev/null 2>&1; then
		die "selftest: U-Boot write must be rejected for NVMe"
	fi
	RK3588_INSTALL_RTC=YES
	RK3588_INSTALL_WATCHDOG=YES
	choose_rk3588_services
	assert_eq "${enable_rtc}" YES
	assert_eq "${enable_watchdog}" YES
	RK3588_INSTALL_RTC=NO
	RK3588_INSTALL_WATCHDOG=NO
	choose_rk3588_services
	assert_eq "${enable_rtc}" NO
	assert_eq "${enable_watchdog}" NO
	unset RK3588_INSTALL_RTC
	unset RK3588_INSTALL_WATCHDOG
	echo "rk3588-install selftest passed"
}

case "${1:-launch}" in
launch)
	install_system
	;;
install)
	shift
	install_system "${1:-}"
	;;
selftest)
	selftest
	;;
*)
	die "usage: ${0##*/} [launch | install [disk] | selftest]"
	;;
esac
