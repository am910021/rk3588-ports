#!/bin/sh
#-
# SPDX-License-Identifier: BSD-2-Clause
#
# Copyright (c) 2026 Fang, Wei-Xiang (Yuri) <am910021@gmail.com>
#

set -eu

ESP=/boot/efi
IMAGE_NAME=firmware-update.bin
REQUEST_NAME=uboot-spi-update.request
UPDATE_SIZE=16252928

die()
{
	echo "${0##*/}: $*" >&2
	exit 1
}

help()
{
	printf '%s\n' \
	    "usage: ${0##*/} verify firmware-update.bin" \
	    "       ${0##*/} [-e esp-mount] stage firmware-update.bin" \
	    "       ${0##*/} [-e esp-mount] show" \
	    "       ${0##*/} [-e esp-mount] clear" \
	    "" \
	    "stage writes a one-shot request; G98 U-Boot updates SPI at next boot." \
	    "Never remove power while U-Boot is updating SPI."
}

usage()
{
	help >&2
	exit 64
}

verify_image()
{
	image=$1
	[ -f "${image}" ] || die "firmware image not found: ${image}"
	size=$(stat -f '%z' "${image}") || die "cannot stat ${image}"
	[ "${size}" -eq "${UPDATE_SIZE}" ] ||
	    die "invalid image size ${size}; expected ${UPDATE_SIZE} (0xf80000)"
	LC_ALL=C grep -aq 'G98-RK3588-' "${image}" ||
	    die "image does not contain the G98 firmware marker"
	digest=$(sha256 -q "${image}") || die "cannot hash ${image}"
	printf 'size=%s\nsha256=%s\n' "${size}" "${digest}"
}

check_esp()
{
	[ "$(id -u)" -eq 0 ] || die "must be run as root"
	[ -d "${ESP}" ] || die "ESP mount point not found: ${ESP}"
	mount -p | awk -v path="${ESP}" '
	    $2 == path && $3 == "msdosfs" { found = 1 }
	    END { exit !found }
	' || die "not a mounted msdosfs ESP: ${ESP}"
}

stage_update()
{
	image=$1
	metadata=$(verify_image "${image}")
	digest=$(printf '%s\n' "${metadata}" | awk -F= '$1 == "sha256" { print $2 }')
	request=${ESP}/${REQUEST_NAME}
	payload=${ESP}/${IMAGE_NAME}
	payload_tmp=$(mktemp "${payload}.XXXXXX") || die "cannot create payload"
	request_tmp=
	trap 'rm -f "${payload_tmp}" "${request_tmp}"' EXIT HUP INT TERM
	request_tmp=$(mktemp "${request}.XXXXXX") || die "cannot create request"

	cp "${image}" "${payload_tmp}"
	chmod 600 "${payload_tmp}"
	mv -f "${payload_tmp}" "${payload}"
	{
		printf 'version=1\n'
		printf 'size=%s\n' "${UPDATE_SIZE}"
		printf 'sha256=%s\n' "${digest}"
	} >"${request_tmp}"
	chmod 600 "${request_tmp}"
	mv -f "${request_tmp}" "${request}"
	trap - EXIT HUP INT TERM
	sync
	printf '%s\n' \
	    "Staged ${payload}" \
	    "Staged one-shot request ${request}" \
	    "Reboot to update SPI; do not remove power during the U-Boot update."
}

self_test()
{
	test_image=$(mktemp -t rk3588-uboot-flash) || exit 1
	trap 'rm -f "${test_image}"' EXIT HUP INT TERM
	truncate -s "${UPDATE_SIZE}" "${test_image}"
	printf 'G98-RK3588-self-test' | dd of="${test_image}" conv=notrunc \
	    status=none
	verify_image "${test_image}" | grep -q '^sha256='
	echo "${0##*/}: self-test passed"
}

[ "${1:-}" != self-test ] || {
	self_test
	exit
}

[ "$#" -gt 0 ] || {
	help
	exit
}

if [ "${1:-}" = -e ]; then
	[ "$#" -ge 3 ] || usage
	ESP=${2%/}
	shift 2
fi
[ -n "${ESP}" ] || usage
command=${1:-}
[ -n "${command}" ] || usage
shift

case "${command}" in
help|-h|--help)
	[ "$#" -eq 0 ] || usage
	help
	;;
verify)
	[ "$#" -eq 1 ] || usage
	verify_image "$1"
	;;
stage)
	[ "$#" -eq 1 ] || usage
	check_esp
	stage_update "$1"
	;;
show)
	[ "$#" -eq 0 ] || usage
	check_esp
	if [ -f "${ESP}/${REQUEST_NAME}" ]; then
		cat "${ESP}/${REQUEST_NAME}"
	else
		echo "No pending SPI firmware update."
	fi
	;;
clear)
	[ "$#" -eq 0 ] || usage
	check_esp
	rm -f "${ESP}/${REQUEST_NAME}" "${ESP}/${IMAGE_NAME}"
	sync
	echo "Cleared pending SPI firmware update from ${ESP}."
	;;
*) usage ;;
esac
