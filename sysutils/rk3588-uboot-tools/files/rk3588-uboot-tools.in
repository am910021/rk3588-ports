set -eu

ESP=/boot/efi
REQUEST_NAME=uboot-env.request
IMAGE_NAME=firmware-update.bin
SPI_REQUEST_NAME=uboot-spi-update.request
COMPAT_PREFIX=RK3588-FW-COMPAT-V1:
VERSION_PREFIX=RK3588-FW-VERSION-V1:
TARGET_PREFIX=RK3588-FW-TARGET-V1:

die()
{
	echo "${0##*/}: $*" >&2
	exit 1
}

help()
{
	printf '%s\n' \
	    "usage: ${0##*/} [-e esp-mount] show [list|next|now|watchdog]" \
	    "       ${0##*/} [-e esp-mount] clear" \
	    "       ${0##*/} [-e esp-mount] set name=value [...]" \
	    "       ${0##*/} [-e esp-mount] watchdog off|on 60" \
	    "       ${0##*/} [-e esp-mount] upgrade firmware-update.bin" \
	    "       ${0##*/} [-e esp-mount] upgrade verify firmware-update.bin" \
	    "       ${0##*/} [-e esp-mount] upgrade show|clear" \
	    "" \
	    "Settings:" \
	    "  freebsd_default_boot  auto or mmcN:P, usbN:P, nvmeN:P, scsiN:P" \
	    "  bootmenu_title        1-80 printable ASCII characters" \
	    "  bootmenu_delay        0-99 seconds" \
	    "  logo_delay            0-99 seconds" \
	    "  freebsd_watchdog_enable  0 or 1" \
	    "  freebsd_watchdog_timeout 60 seconds" \
	    "" \
	    "show list  List targets detected by the current U-Boot." \
	    "show now   Show the target selected for this boot." \
	    "show next  Show the pending one-shot request (default for bare show)." \
	    "show watchdog  Show the watchdog state used for this boot." \
	    "upgrade  Verify and stage a compatible one-shot firmware update."
}

usage()
{
	help >&2
	exit 64
}

is_uint()
{
	case "$1" in
	''|*[!0-9]*) return 1 ;;
	*) return 0 ;;
	esac
}

valid_target()
{
	[ "$1" = auto ] && return 0
	iface=${1%%[0-9]*}
	rest=${1#"${iface}"}
	case "${iface}" in
	mmc|usb|nvme|scsi) ;;
	*) return 1 ;;
	esac
	case "${rest}" in
	*:*:*) return 1 ;;
	*:*) ;;
	*) return 1 ;;
	esac
	dev=${rest%%:*}
	part=${rest#*:}
	is_uint "${dev}" && [ "${dev}" -le 255 ] &&
	    is_uint "${part}" && [ "${part}" -ge 1 ] &&
	    [ "${part}" -le 128 ]
}

valid_delay()
{
	is_uint "$1" && [ "$1" -le 99 ]
}

valid_watchdog_timeout()
{
	[ "$1" = 60 ]
}

valid_title()
{
	newline='
'
	[ -n "$1" ] && [ "${#1}" -le 80 ] &&
	    case "$1" in *"${newline}"*) false ;; *) true ;; esac &&
	    printf '%s\n' "$1" | LC_ALL=C grep -Eq '^[[:print:]]+$'
}

check_esp()
{
	[ "$(id -u)" -eq 0 ] || die "must be run as root"
	[ -d "${ESP}" ] || die "ESP mount point not found: ${ESP}"
	mount -p | awk -v path="${ESP}" '
	    $2 == path && $3 == "msdosfs" { found = 1 }
	    END { exit !found }
	' || die "not a mounted msdosfs ESP: ${ESP}"
}

load_firmware_identity()
{
	EXPECTED_COMPAT=$(ofwdump -P freebsd,uboot-firmware-compat -S /chosen 2>/dev/null || true)
	UPDATE_SIZE=$(ofwdump -P freebsd,uboot-firmware-size -S /chosen 2>/dev/null || true)
	FIRMWARE_STORAGE=$(ofwdump -P freebsd,uboot-firmware-storage -S /chosen 2>/dev/null || true)
	[ -n "${EXPECTED_COMPAT}" ] ||
	    die "current U-Boot does not support EFI-staged firmware updates"
	case "${EXPECTED_COMPAT}" in *[!A-Za-z0-9:._-]*) die "invalid running firmware marker" ;; esac
	case "${UPDATE_SIZE}" in ''|*[!0-9]*) die "invalid running firmware size" ;; esac
	[ "${UPDATE_SIZE}" -gt 0 ] || die "invalid running firmware size"
	case "${FIRMWARE_STORAGE}" in MMC|SPI) ;; *) die "invalid running firmware storage" ;; esac
}

verify_firmware()
{
	image=$1
	[ -f "${image}" ] || die "firmware image not found: ${image}"
	size=$(stat -f '%z' "${image}") || die "cannot stat ${image}"
	candidate=$(LC_ALL=C strings -a "${image}" | awk -v prefix="${COMPAT_PREFIX}" '
	    index($0, prefix) == 1 { total++; value=substr($0, length(prefix) + 1) }
	    END { if (total == 1) print value; else exit 1 }
	') || die "firmware compatibility marker is missing or duplicated"
	target=$(dd if="${image}" bs=512 skip=$((size / 512 - 1)) count=1 status=none |
	    LC_ALL=C strings -a | awk -v prefix="${TARGET_PREFIX}" '
	    index($0, prefix) == 1 { total++; value=substr($0, length(prefix) + 1) }
	    END { if (total == 1) print value; else exit 1 }
	') || die "firmware target marker is missing or duplicated"
	board=${EXPECTED_COMPAT%%:*}
	capacity=${EXPECTED_COMPAT##*:}
	expected_target=${board}:${FIRMWARE_STORAGE}:${capacity}
	if [ "${candidate}" = "${EXPECTED_COMPAT}" ]; then
		[ "${size}" -eq "${UPDATE_SIZE}" ] ||
		    die "invalid image size ${size}; expected ${UPDATE_SIZE}"
		[ "${target}" = "${expected_target}" ] ||
		    die "firmware target ${target} does not match ${expected_target}"
	elif [ "${FIRMWARE_STORAGE}" = SPI ] &&
	    [ "${EXPECTED_COMPAT}" = "${EXPECTED_COMPAT%:SPI:16M}:SPI:16M" ] &&
	    [ "${candidate}" = "${EXPECTED_COMPAT%:SPI:16M}:SPI:32M" ]; then
		[ "${size}" -eq 33030144 ] ||
		    die "invalid 32M migration image size ${size}; expected 33030144"
		[ "${target}" = "${board}:SPI:32M" ] ||
		    die "invalid SPI migration target ${target}"
	else
		die "firmware compatibility marker does not match ${EXPECTED_COMPAT}"
	fi
	version=$(LC_ALL=C strings -a "${image}" | awk -v prefix="${VERSION_PREFIX}" '
	    index($0, prefix) == 1 { total++; value=$0 }
	    END { if (total == 1) print value; else exit 1 }
	') || die "firmware version marker is missing or duplicated"
	digest=$(sha256 -q "${image}") || die "cannot hash ${image}"
	printf 'compat=%s\ntarget=%s\nsize=%s\nsha256=%s\nversion=%s\n' \
	    "${candidate}" "${target}" "${size}" "${digest}" \
	    "${version#${VERSION_PREFIX}}"
}

stage_firmware()
{
	image=$1
	metadata=$(verify_firmware "${image}")
	digest=$(printf '%s\n' "${metadata}" | awk -F= '$1 == "sha256" { print $2 }')
	size=$(printf '%s\n' "${metadata}" | awk -F= '$1 == "size" { print $2 }')
	request=${ESP}/${SPI_REQUEST_NAME}
	payload=${ESP}/${IMAGE_NAME}
	payload_tmp=$(mktemp "${payload}.XXXXXX") || die "cannot create payload"
	request_tmp=
	trap 'rm -f "${payload_tmp}" "${request_tmp}"' EXIT HUP INT TERM
	request_tmp=$(mktemp "${request}.XXXXXX") || die "cannot create request"

	cp "${image}" "${payload_tmp}"
	chmod 600 "${payload_tmp}"
	mv -f "${payload_tmp}" "${payload}"
	{
		printf 'version=1\n'
		printf 'size=%s\n' "${size}"
		printf 'sha256=%s\n' "${digest}"
	} >"${request_tmp}"
	chmod 600 "${request_tmp}"
	mv -f "${request_tmp}" "${request}"
	trap - EXIT HUP INT TERM
	sync
	printf '%s\n' "${metadata}" \
	    "Staged ${payload}" \
	    "Staged one-shot request ${request}" \
	    "Reboot to update ${FIRMWARE_STORAGE}; do not remove power during the U-Boot update."
}

write_request()
{
	request=${ESP}/${REQUEST_NAME}
	temporary=$(mktemp "${request}.XXXXXX") || die "cannot create request"
	trap 'rm -f "${temporary}"' EXIT HUP INT TERM
	{
		[ "${have_default}" -eq 0 ] ||
		    printf 'freebsd_default_boot=%s\n' "${default_value}"
		[ "${have_title}" -eq 0 ] ||
		    printf 'bootmenu_title=%s\n' "${title_value}"
		[ "${have_delay}" -eq 0 ] ||
		    printf 'bootmenu_delay=%s\n' "${delay_value}"
		[ "${have_logo_delay}" -eq 0 ] ||
		    printf 'logo_delay=%s\n' "${logo_delay_value}"
		[ "${have_watchdog_enable}" -eq 0 ] ||
		    printf 'freebsd_watchdog_enable=%s\n' "${watchdog_enable_value}"
		[ "${have_watchdog_timeout}" -eq 0 ] ||
		    printf 'freebsd_watchdog_timeout=%s\n' "${watchdog_timeout_value}"
	} >"${temporary}"
	chmod 600 "${temporary}"
	mv -f "${temporary}" "${request}"
	trap - EXIT HUP INT TERM
	sync
	echo "Wrote ${request}; settings take effect once at next boot."
}

print_targets()
{
	targets=$1
	selected=$2
	echo "Available U-Boot targets:"
	printf '%s\n' "${targets}" | tr ',' '\n' |
	while IFS= read -r target; do
		[ -n "${target}" ] || continue
		if [ "${target}" = "${selected}" ]; then
			printf '  %s (current)\n' "${target}"
		else
			printf '  %s\n' "${target}"
		fi
	done
}

show_list()
{
	targets=$(ofwdump -P freebsd,boot-targets -S /chosen 2>/dev/null || true)
	[ -n "${targets}" ] ||
	    die "current U-Boot did not publish targets; reboot with the updated firmware"
	selected=$(ofwdump -P freebsd,boot-target -S /chosen 2>/dev/null || true)
	print_targets "${targets}" "${selected}"
}

show_now()
{
	selected=$(ofwdump -P freebsd,boot-target -S /chosen 2>/dev/null || true)
	[ -n "${selected}" ] ||
	    die "current U-Boot did not publish its target; reboot with the updated firmware"
	echo "Current U-Boot target: ${selected}"
}

show_watchdog()
{
	enabled=$(ofwdump -P freebsd,uboot-watchdog-enabled -S /chosen 2>/dev/null || true)
	timeout=$(ofwdump -P freebsd,uboot-watchdog-timeout -S /chosen 2>/dev/null || true)
	[ -n "${enabled}" ] && valid_watchdog_timeout "${timeout}" ||
	    die "current U-Boot did not publish its watchdog state; reboot with the updated firmware"
	case "${enabled}" in
	0) echo "U-Boot watchdog: disabled (saved timeout: ${timeout} seconds)" ;;
	1) echo "U-Boot watchdog: enabled (${timeout}-second request)" ;;
	*) die "current U-Boot published an invalid watchdog state" ;;
	esac
}

self_test()
{
	EXPECTED_COMPAT=G98:SPI:16M
	UPDATE_SIZE=16252928
	FIRMWARE_STORAGE=SPI
	test_image=$(mktemp -t rk3588-uboot-tools) || exit 1
	migration_image=$(mktemp -t rk3588-uboot-tools-migration) || exit 1
	trap 'rm -f "${test_image}" "${migration_image}"' EXIT HUP INT TERM
	truncate -s "${UPDATE_SIZE}" "${test_image}"
	printf '%s\0%s\0' "${COMPAT_PREFIX}${EXPECTED_COMPAT}" \
	    "${VERSION_PREFIX}self-test" | dd of="${test_image}" conv=notrunc status=none
	printf '%s\0' "${TARGET_PREFIX}G98:SPI:16M" | dd of="${test_image}" \
	    bs=1 seek=$((UPDATE_SIZE - 512)) conv=notrunc status=none
	verify_firmware "${test_image}" | grep -q '^sha256='
	FIRMWARE_STORAGE=MMC
	printf '%s\0' "${TARGET_PREFIX}G98:MMC:16M" | dd of="${test_image}" \
	    bs=1 seek=$((UPDATE_SIZE - 512)) conv=notrunc status=none
	verify_firmware "${test_image}" | grep -q '^target=G98:MMC:16M$'
	FIRMWARE_STORAGE=SPI
	truncate -s 33030144 "${migration_image}"
	printf '%s\0%s\0' "${COMPAT_PREFIX}G98:SPI:32M" \
	    "${VERSION_PREFIX}migration-self-test" | dd of="${migration_image}" \
	    conv=notrunc status=none
	printf '%s\0' "${TARGET_PREFIX}G98:SPI:32M" | dd of="${migration_image}" \
	    bs=1 seek=$((33030144 - 512)) conv=notrunc status=none
	verify_firmware "${migration_image}" | grep -q '^compat=G98:SPI:32M$'
	valid_target auto
	valid_target usb0:2
	valid_target nvme255:128
	! valid_target usb256:2
	! valid_target usb0:0
	valid_delay 0
	valid_delay 99
	! valid_delay 100
	valid_watchdog_timeout 60
	! valid_watchdog_timeout 15
	! valid_watchdog_timeout 0
	valid_title '*** FreeBSD U-Boot Boot Menu ***'
	! valid_title ''
	help | grep -q freebsd_default_boot
	print_targets 'mmc0:2,usb0:2' usb0:2 | grep -q 'usb0:2 (current)'
	echo "${0##*/}: self-test passed"
}

[ "${1:-}" != self-test ] || {
	self_test
	exit
}

[ "$#" -gt 0 ] || {
	help
	exit
}

if [ "${1:-}" = -e ]; then
	[ "$#" -ge 3 ] || usage
	ESP=${2%/}
	shift 2
fi
[ -n "${ESP}" ] || usage
command=${1:-}
[ -n "${command}" ] || usage
shift

case "${command}" in
help|-h|--help)
	[ "$#" -eq 0 ] || usage
	help
	;;
show)
	[ "$#" -le 1 ] || usage
	case "${1:-next}" in
	list) show_list ;;
	now) show_now ;;
	next)
		check_esp
		if [ -f "${ESP}/${REQUEST_NAME}" ]; then
			cat "${ESP}/${REQUEST_NAME}"
		else
			echo "No pending U-Boot request."
		fi
		;;
		watchdog) show_watchdog ;;
		*) usage ;;
	esac
	;;
clear)
	[ "$#" -eq 0 ] || usage
	check_esp
	rm -f "${ESP}/${REQUEST_NAME}"
	sync
	echo "Cleared ${ESP}/${REQUEST_NAME}."
	;;
set)
	[ "$#" -gt 0 ] || usage
	have_default=0
	have_title=0
	have_delay=0
	have_logo_delay=0
	have_watchdog_enable=0
	have_watchdog_timeout=0
	for assignment in "$@"; do
		case "${assignment}" in
		*=*) name=${assignment%%=*}; value=${assignment#*=} ;;
		*) die "expected name=value: ${assignment}" ;;
		esac
		case "${name}" in
		freebsd_default_boot)
			[ "${have_default}" -eq 0 ] || die "duplicate ${name}"
			valid_target "${value}" || die "invalid boot target: ${value}"
			have_default=1
			default_value=${value}
			;;
		bootmenu_title)
			[ "${have_title}" -eq 0 ] || die "duplicate ${name}"
			valid_title "${value}" || die "invalid menu title"
			have_title=1
			title_value=${value}
			;;
		bootmenu_delay)
			[ "${have_delay}" -eq 0 ] || die "duplicate ${name}"
			valid_delay "${value}" || die "invalid menu delay: ${value}"
			have_delay=1
			delay_value=${value}
			;;
		logo_delay)
			[ "${have_logo_delay}" -eq 0 ] || die "duplicate ${name}"
			valid_delay "${value}" || die "invalid logo delay: ${value}"
			have_logo_delay=1
			logo_delay_value=${value}
			;;
		freebsd_watchdog_enable)
			[ "${have_watchdog_enable}" -eq 0 ] || die "duplicate ${name}"
			case "${value}" in 0|1) ;; *) die "invalid watchdog state: ${value}" ;; esac
			have_watchdog_enable=1
			watchdog_enable_value=${value}
			;;
		freebsd_watchdog_timeout)
			[ "${have_watchdog_timeout}" -eq 0 ] || die "duplicate ${name}"
			valid_watchdog_timeout "${value}" || die "invalid watchdog timeout: ${value}"
			have_watchdog_timeout=1
			watchdog_timeout_value=${value}
			;;
		*) die "unsupported setting: ${name}" ;;
		esac
	done
	check_esp
	write_request
	;;
watchdog)
	case "$#:${1:-}" in
	1:off)
		have_watchdog_enable=1
		watchdog_enable_value=0
		have_watchdog_timeout=0
		;;
	2:on)
		valid_watchdog_timeout "$2" || die "invalid watchdog timeout: $2"
		have_watchdog_enable=1
		watchdog_enable_value=1
		have_watchdog_timeout=1
		watchdog_timeout_value=$2
		;;
	*) usage ;;
	esac
	have_default=0
	have_title=0
	have_delay=0
	have_logo_delay=0
	check_esp
	write_request
	;;
upgrade)
	case "$#:${1:-}" in
	1:show)
		check_esp
		if [ -f "${ESP}/${SPI_REQUEST_NAME}" ]; then
			cat "${ESP}/${SPI_REQUEST_NAME}"
		else
			echo "No pending SPI firmware update."
		fi
		;;
	1:clear)
		check_esp
		rm -f "${ESP}/${SPI_REQUEST_NAME}" "${ESP}/${IMAGE_NAME}"
		sync
		echo "Cleared pending SPI firmware update from ${ESP}."
		;;
	2:verify)
		load_firmware_identity
		verify_firmware "$2"
		;;
	1:*)
		check_esp
		load_firmware_identity
		stage_firmware "$1"
		;;
	*) usage ;;
	esac
	;;
*) usage ;;
esac
